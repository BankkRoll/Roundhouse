{
  "admin": {
    "listen": "localhost:2019"
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "openrail": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "2s"
                  },
                  "upstreams": [
                    {
                      "dial": "172.18.0.3:3000"
                    },
                    {
                      "dial": "172.18.0.4:3000"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "api.example.com"
                  ],
                  "path": [
                    "/v1",
                    "/v1/*"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "2s"
                  },
                  "upstreams": [
                    {
                      "dial": "172.18.0.2:3000"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "api.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "2s"
                  },
                  "upstreams": [
                    {
                      "dial": "172.19.0.2:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "web-production-x7k2.127.0.0.1.nip.io"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "no route\n",
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "internal"
              }
            ],
            "subjects": [
              "api.example.com",
              "web-production-x7k2.127.0.0.1.nip.io"
            ]
          }
        ]
      }
    }
  }
}
