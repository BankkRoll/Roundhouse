        "roundhouse_http": {
          "automatic_https": {
            "disable": true
          },
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "rewrite",
                  "uri": "/v1/acme/http-01/{http.request.uri.path.file}"
                },
                {
                  "handler": "reverse_proxy",
                  "headers": {
                    "request": {
                      "set": {
                        "Host": [
                          "cp.example.com"
                        ]
                      }
                    }
                  },
                  "transport": {
                    "protocol": "http",
                    "tls": {
                      "server_name": "cp.example.com"
                    }
                  },
                  "upstreams": [
                    {
                      "dial": "cp.example.com:443"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "api.apps.example.com",
                    "pending.customer.test",
                    "shop.customer.test"
                  ],
                  "path": [
                    "/.well-known/acme-challenge/*"
                  ],
                  "path_regexp": {
                    "pattern": "^/\\.well-known/acme-challenge/[A-Za-z0-9_-]{1,256}$"
                  }
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "on_demand": {
          "permission": {
            "endpoint": "http://127.0.0.1:2020/ask",
            "module": "http"
          }
        },
        "policies": [
          {
            "on_demand": true
          }
        ]
      },
      "certificates": {
        "load_files": [
          {
            "certificate": "/var/lib/roundhouse-certs/cer_shop.pem",
            "key": "/var/lib/roundhouse-certs/cer_shop.pem",
            "tags": [
              "roundhouse:cer_shop",
              "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            ]
          },
          {
            "certificate": "/var/lib/roundhouse-certs/cer_wild.pem",
            "key": "/var/lib/roundhouse-certs/cer_wild.pem",
            "tags": [
              "roundhouse:cer_wild",
              "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "roundhouse_tls": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "tls"
        ],
        "level": "INFO",
        "writer": {
          "address": "127.0.0.1:2022",
          "dial_timeout": "2s",
          "output": "net",
          "soft_start": true
        }
      }
    }
  }
