# Local settings for `wrangler dev`. `pnpm setup:dev` copies this file to
# `.dev.vars` (gitignored) and fills in MASTER_KEY.
#
# Every key here is a Worker secret or variable typed in `src/env.ts`; the
# reference, with production guidance, is docs/configuration.md.
#
# IMPORTANT: this file is for development only. Never commit a filled-in
# `.dev.vars`, and never upload it to a production Worker as is: ROUNDHOUSE_DEV
# turns off checks production depends on.

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

# Root secret of the install, base64 of 32 random bytes. The auth secret and
# every encryption key are derived from it, so losing it means losing access
# to everything encrypted. Generate with: openssl rand -base64 32
MASTER_KEY=

# Master keys that MASTER_KEY replaced, comma-separated, newest first. Only
# set while a key rotation is in progress; see "Rotating the master key" in
# docs/configuration.md.
# MASTER_KEYS_PREVIOUS=

# Cloudflare API token with Account Analytics Read, for reading metrics back
# from Analytics Engine. Unset in development: metrics use D1 instead.
# CF_ANALYTICS_TOKEN=

# -----------------------------------------------------------------------------
# Variables
# -----------------------------------------------------------------------------

# Allows plain http:// origins (OAuth issuer, provider callbacks) and lets
# agents run workloads over ws://. Development only.
ROUNDHOUSE_DEV=1

# The control plane's public origin: links, cookies, OAuth metadata and the
# same-origin check use it, never the request's Host. Required in production
# (503 public_origin_missing without it); with ROUNDHOUSE_DEV=1 and no value,
# the request's origin is used (the Vite proxy on :5173 keeps Host).
# PUBLIC_ORIGIN=http://localhost:5173

# DNS-over-HTTPS JSON endpoint for custom-domain checks. Defaults to
# Cloudflare's resolver, with Google's as the fallback.
# DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query

# GitHub REST API origin for every App call: GitHub Enterprise, or a fake
# GitHub when testing previews locally. https only (http with ROUNDHOUSE_DEV=1).
# GITHUB_API_URL=https://api.github.com

# Cloudflare account ID for the Analytics Engine SQL API, with CF_ANALYTICS_TOKEN.
# CF_ACCOUNT_ID=

# `d1` forces the short-retention D1 metrics store; unset picks Analytics
# Engine when its credentials are set.
# METRICS_BACKEND=d1

# -----------------------------------------------------------------------------
# Test and development knobs (leave unset in production)
# -----------------------------------------------------------------------------

# Seconds a rollout waits for healthy replicas (10 to 600, default 600).
# ROLLOUT_TIMEOUT_S=60

# Seconds a provisioned cloud server gets to join (default 600), and seconds
# between join checks (default 10).
# PROVISION_JOIN_TIMEOUT_S=120
# PROVISION_JOIN_POLL_S=5

# Agent metrics sampling interval in ms (default 15000).
# METRICS_INTERVAL_MS=5000
