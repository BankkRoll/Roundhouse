{
  "name": "@roundhouse/api",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-assets-dir.mjs && wrangler dev",
    "deploy": "pnpm --filter @roundhouse/web build && wrangler deploy && wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "node scripts/ensure-assets-dir.mjs && wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@roundhouse/db": "workspace:*",
    "@roundhouse/protocol": "workspace:*",
    "@roundhouse/shared": "workspace:*",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.152.0"
  }
}
