{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roundhouse",
  "main": "src/index.ts",
  // NOTE: Pinned to the newest date the workerd bundled with
  // @cloudflare/vitest-plugin supports, so tests run with the same runtime
  // behaviour as production. Bump it together with that package.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // NOTE: There is no `vars` block: every setting in src/env.ts is optional
  // and per install (docs/configuration.md). Without keep_vars, each
  // `wrangler deploy` would delete plain-text variables an operator set in
  // the Cloudflare dashboard, such as PUBLIC_ORIGIN. Secrets survive either way.
  "keep_vars": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/api/*", "/install.sh", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  // NOTE: No `database_id` on purpose: `wrangler deploy` provisions the D1
  // database on the first deploy and reuses it afterwards, so a self-hoster
  // never copies IDs around. That is also why `pnpm run deploy` applies
  // migrations after `wrangler deploy`, not before: until the first deploy
  // there is no remote database to migrate.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roundhouse",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Created on the first deploy if missing, like the D1 database.
  "r2_buckets": [{ "binding": "LOGS", "bucket_name": "roundhouse-logs" }],
  "durable_objects": {
    "bindings": [
      { "name": "NODE_CONNECTION", "class_name": "NodeConnection" },
      { "name": "PROJECT_ROOM", "class_name": "ProjectRoom" },
      { "name": "AUDIT_CHAIN", "class_name": "AuditChain" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NodeConnection"] },
    { "tag": "v2", "new_sqlite_classes": ["ProjectRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["AuditChain"] }
  ],
  "workflows": [
    { "name": "roundhouse-deploy", "binding": "DEPLOY_WORKFLOW", "class_name": "DeployWorkflow" },
    {
      "name": "roundhouse-key-rotation",
      "binding": "KEY_ROTATION_WORKFLOW",
      "class_name": "KeyRotationWorkflow"
    },
    {
      "name": "roundhouse-provision",
      "binding": "PROVISION_WORKFLOW",
      "class_name": "ProvisionWorkflow"
    },
    { "name": "roundhouse-backup", "binding": "BACKUP_WORKFLOW", "class_name": "BackupWorkflow" },
    {
      "name": "roundhouse-restore",
      "binding": "RESTORE_WORKFLOW",
      "class_name": "RestoreWorkflow"
    },
    {
      "name": "roundhouse-volume-migration",
      "binding": "VOLUME_MIGRATION_WORKFLOW",
      "class_name": "VolumeMigrationWorkflow"
    },
    {
      "name": "roundhouse-certificate",
      "binding": "CERT_WORKFLOW",
      "class_name": "CertificateWorkflow"
    },
    {
      "name": "roundhouse-cron-run",
      "binding": "CRON_RUN_WORKFLOW",
      "class_name": "CronRunWorkflow"
    },
    { "name": "roundhouse-drain", "binding": "DRAIN_WORKFLOW", "class_name": "DrainWorkflow" }
  ],
  // NOTE: namespace_id is shared by every Worker in the Cloudflare account, so
  // a small number like the docs' "1001" can collide with another project's
  // limiter and pool their counters. Any unique positive integer works.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "730214591",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // GitHub sends bursts (one delivery per push, per installation event)
      // from a small pool of addresses, so this one is far looser.
      "name": "WEBHOOK_LIMITER",
      "namespace_id": "730214592",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      // MCP tool calls, keyed by API token (ADR 0012).
      "name": "MCP_LIMITER",
      "namespace_id": "730214593",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // The public ACME HTTP-01 responder (ADR 0009), keyed by client IP:
      // the ingress nodes proxying a CA's validation requests.
      "name": "ACME_LIMITER",
      "namespace_id": "730214594",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Container and node metrics (ADR 0008). Reading them back needs the
  // CF_ACCOUNT_ID variable and the CF_ANALYTICS_TOKEN secret ("Account
  // Analytics Read"); without both, the short-retention D1 fallback
  // (`metrics_samples`) answers instead. METRICS_BACKEND=d1 forces it.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "roundhouse_metrics" }],
  // Hourly retention: expired log chunks (R2 and D1), GitHub delivery IDs,
  // join tokens, sessions, invites, verifications. See src/lib/retention.ts.
  // Every minute: custom-domain DNS checks that are due (src/lib/domains/check.ts),
  // certificate orders and renewals in the managed TLS mode (src/lib/certificates),
  // cron service runs (src/lib/cron/schedule.ts) and the other claimers in src/lib/dispatch.ts.
  "triggers": { "crons": ["17 * * * *", "* * * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "observability": { "enabled": true }
}
