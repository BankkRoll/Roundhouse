{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!pnpm-lock.yaml",
      "!**/testdata",
      "!**/routeTree.gen.ts",
      "!**/migrations",
      "!**/worker-configuration.d.ts",
      "!packages/protocol/schema",
      "!packages/protocol/fixtures/signed-*.json",
      "!packages/protocol/fixtures/spec-hash.json",
      "!packages/protocol/fixtures/sealed-box.json",
      "!packages/protocol/fixtures/encryption-key.json",
      "!packages/protocol/fixtures/redaction.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
