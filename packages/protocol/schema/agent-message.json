{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocol_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "node_id": {
          "type": "string",
          "maxLength": 64
        },
        "agent_version": {
          "type": "string",
          "maxLength": 256
        },
        "os": {
          "type": "string",
          "maxLength": 256
        },
        "arch": {
          "type": "string",
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "kernel": {
          "type": "string",
          "maxLength": 256
        },
        "docker_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "type": "object",
          "properties": {
            "cpu_cores": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "mem_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disk_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "cpu_cores",
            "mem_bytes",
            "disk_bytes"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "docker": {
              "type": "boolean"
            },
            "gvisor": {
              "type": "boolean"
            },
            "builder": {
              "type": "boolean"
            }
          },
          "required": [
            "docker",
            "gvisor",
            "builder"
          ],
          "additionalProperties": false
        },
        "observed_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "statuses": {
          "maxItems": 160,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workload_id": {
                "type": "string",
                "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
              },
              "deployment_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "pulling",
                  "starting",
                  "running",
                  "healthy",
                  "unhealthy",
                  "exited",
                  "crashed",
                  "removed"
                ]
              },
              "container_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{12,64}$"
              },
              "exit_code": {
                "type": "integer",
                "minimum": -1,
                "maximum": 255
              },
              "message": {
                "type": "string",
                "minLength": 0
              },
              "restarts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "workload_id",
              "deployment_id",
              "state",
              "restarts",
              "ts"
            ],
            "additionalProperties": false
          }
        },
        "encryption_key": {
          "type": "object",
          "properties": {
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{43}=$"
            },
            "kid": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            },
            "sig": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{86}==$"
            }
          },
          "required": [
            "public_key",
            "kid",
            "sig"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "protocol_version",
        "node_id",
        "agent_version",
        "os",
        "arch",
        "kernel",
        "docker_version",
        "hardware",
        "capabilities",
        "observed_generation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "heartbeat"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usage": {
          "type": "object",
          "properties": {
            "cpu_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "mem_used_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mem_total_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disk_used_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disk_total_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "load1": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "cpu_percent",
            "mem_used_bytes",
            "mem_total_bytes",
            "disk_used_bytes",
            "disk_total_bytes",
            "load1"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "seq",
        "ts",
        "observed_generation",
        "usage"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "workload_id": {
          "type": "string",
          "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
        },
        "deployment_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "pulling",
            "starting",
            "running",
            "healthy",
            "unhealthy",
            "exited",
            "crashed",
            "removed"
          ]
        },
        "container_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{12,64}$"
        },
        "exit_code": {
          "type": "integer",
          "minimum": -1,
          "maximum": 255
        },
        "message": {
          "type": "string",
          "minLength": 0
        },
        "restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "workload_status"
        }
      },
      "required": [
        "workload_id",
        "deployment_id",
        "state",
        "restarts",
        "ts",
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "logs"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "runtime"
                },
                "workload_id": {
                  "type": "string",
                  "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
                },
                "deployment_id": {
                  "type": "string",
                  "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
                }
              },
              "required": [
                "type",
                "workload_id",
                "deployment_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "build"
                },
                "build_id": {
                  "type": "string",
                  "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
                }
              },
              "required": [
                "type",
                "build_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "stream": {
                "type": "string",
                "enum": [
                  "stdout",
                  "stderr",
                  "system"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 0
              }
            },
            "required": [
              "ts",
              "stream",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "source",
        "lines"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "build_result"
        },
        "build_id": {
          "type": "string",
          "pattern": "^[a-z]{1,8}_[0-9A-Za-z_]{1,64}$"
        },
        "ok": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^(?:[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*(?::[0-9]{1,5})?\\/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:\\/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "repository",
            "digest"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "cancelled": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "build_id",
        "ok",
        "duration_ms"
      ],
      "additionalProperties": false
    }
  ]
}
