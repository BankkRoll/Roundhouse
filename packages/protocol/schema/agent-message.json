{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocol_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "node_id": {
          "type": "string",
          "maxLength": 64
        },
        "agent_version": {
          "type": "string",
          "maxLength": 256
        },
        "os": {
          "type": "string",
          "maxLength": 256
        },
        "arch": {
          "type": "string",
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "kernel": {
          "type": "string",
          "maxLength": 256
        },
        "docker_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "type": "object",
          "properties": {
            "cpu_cores": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "mem_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disk_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "cpu_cores",
            "mem_bytes",
            "disk_bytes"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "docker": {
              "type": "boolean"
            },
            "gvisor": {
              "type": "boolean"
            },
            "builder": {
              "type": "boolean"
            }
          },
          "required": [
            "docker",
            "gvisor",
            "builder"
          ],
          "additionalProperties": false
        },
        "observed_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "protocol_version",
        "node_id",
        "agent_version",
        "os",
        "arch",
        "kernel",
        "docker_version",
        "hardware",
        "capabilities",
        "observed_generation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "heartbeat"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usage": {
          "type": "object",
          "properties": {
            "cpu_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "mem_used_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mem_total_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disk_used_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disk_total_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "load1": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "cpu_percent",
            "mem_used_bytes",
            "mem_total_bytes",
            "disk_used_bytes",
            "disk_total_bytes",
            "load1"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "seq",
        "ts",
        "observed_generation",
        "usage"
      ],
      "additionalProperties": false
    }
  ]
}
