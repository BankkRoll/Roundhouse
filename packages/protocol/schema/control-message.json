{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "heartbeat_interval_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "id",
        "node_id",
        "iat",
        "exp",
        "heartbeat_interval_ms"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "desired_state"
        },
        "id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "image"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "id",
        "node_id",
        "iat",
        "exp",
        "generation",
        "workloads"
      ],
      "additionalProperties": false
    }
  ]
}
