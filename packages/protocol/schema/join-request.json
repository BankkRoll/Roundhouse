{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "hostname": {
      "type": "string",
      "maxLength": 256
    },
    "agent_version": {
      "type": "string",
      "maxLength": 256
    },
    "os": {
      "type": "string",
      "maxLength": 256
    },
    "arch": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "encryption_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "public_ip": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "ipv4",
              "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
            },
            {
              "type": "string",
              "format": "ipv6",
              "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "hardware": {
      "type": "object",
      "properties": {
        "cpu_cores": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mem_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disk_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cpu_cores",
        "mem_bytes",
        "disk_bytes"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "docker": {
          "type": "boolean"
        },
        "gvisor": {
          "type": "boolean"
        },
        "builder": {
          "type": "boolean"
        },
        "ingress": {
          "type": "boolean"
        }
      },
      "required": [
        "docker",
        "gvisor",
        "builder"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "token",
    "name",
    "hostname",
    "agent_version",
    "os",
    "arch",
    "public_key",
    "public_ip",
    "hardware",
    "capabilities"
  ],
  "additionalProperties": false
}
