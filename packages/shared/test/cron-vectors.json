{
  "next": [
    {
      "name": "step",
      "schedule": "*/15 * * * *",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-01T00:15:00Z", "2026-01-01T00:30:00Z", "2026-01-01T00:45:00Z"]
    },
    {
      "name": "daily",
      "schedule": "0 3 * * *",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-01T03:00:00Z", "2026-01-02T03:00:00Z"]
    },
    {
      "name": "range with step and weekday names",
      "schedule": "30 9-17/4 * * MON-FRI",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": [
        "2026-01-01T09:30:00Z",
        "2026-01-01T13:30:00Z",
        "2026-01-01T17:30:00Z",
        "2026-01-02T09:30:00Z",
        "2026-01-02T13:30:00Z",
        "2026-01-02T17:30:00Z",
        "2026-01-05T09:30:00Z"
      ]
    },
    {
      "name": "month name",
      "schedule": "0 0 1 jan *",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2027-01-01T00:00:00Z"]
    },
    {
      "name": "value with step",
      "schedule": "5/20 * * * *",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-01T00:05:00Z", "2026-01-01T00:25:00Z", "2026-01-01T00:45:00Z"]
    },
    {
      "name": "list",
      "schedule": "0 0 * * sun,Wed",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-04T00:00:00Z", "2026-01-07T00:00:00Z"]
    },
    {
      "name": "sunday as 7",
      "schedule": "0 0 * * 7",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-04T00:00:00Z"]
    },
    {
      "name": "@hourly",
      "schedule": "@hourly",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-01T01:00:00Z", "2026-01-01T02:00:00Z"]
    },
    {
      "name": "@weekly",
      "schedule": "@weekly",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-04T00:00:00Z"]
    },
    {
      "name": "@yearly",
      "schedule": "@Annually",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2027-01-01T00:00:00Z"]
    },
    {
      "name": "@monthly",
      "schedule": "@monthly",
      "timezone": "UTC",
      "from": "2026-01-15T00:00:00Z",
      "expect": ["2026-02-01T00:00:00Z"]
    },
    {
      "name": "@daily and @midnight",
      "schedule": "@midnight",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2026-01-02T00:00:00Z"]
    },
    {
      "name": "day of month or day of week",
      "schedule": "0 12 13 * FRI",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": [
        "2026-01-02T12:00:00Z",
        "2026-01-09T12:00:00Z",
        "2026-01-13T12:00:00Z",
        "2026-01-16T12:00:00Z"
      ]
    },
    {
      "name": "29 February",
      "schedule": "0 0 29 2 *",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": ["2028-02-29T00:00:00Z", "2032-02-29T00:00:00Z"]
    },
    {
      "name": "never fires",
      "schedule": "0 0 31 2 *",
      "timezone": "UTC",
      "from": "2026-01-01T00:00:00Z",
      "expect": []
    },
    {
      "name": "zone offset",
      "schedule": "0 3 * * *",
      "timezone": "Europe/Berlin",
      "from": "2026-10-22T00:00:00Z",
      "expect": ["2026-10-22T01:00:00Z", "2026-10-23T01:00:00Z"]
    },
    {
      "name": "New York spring-forward gap runs at the transition",
      "schedule": "30 2 * * *",
      "timezone": "America/New_York",
      "from": "2026-03-07T12:00:00Z",
      "expect": ["2026-03-08T07:00:00Z", "2026-03-09T06:30:00Z"]
    },
    {
      "name": "New York gap slots collapse into one run",
      "schedule": "0,30 2,3 * * *",
      "timezone": "America/New_York",
      "from": "2026-03-08T00:00:00Z",
      "expect": ["2026-03-08T07:00:00Z", "2026-03-08T07:30:00Z", "2026-03-09T06:00:00Z"]
    },
    {
      "name": "New York fall-back runs the first occurrence",
      "schedule": "30 1 * * *",
      "timezone": "America/New_York",
      "from": "2026-10-31T12:00:00Z",
      "expect": ["2026-11-01T05:30:00Z", "2026-11-02T06:30:00Z"]
    },
    {
      "name": "New York repeated hour is not run twice",
      "schedule": "*/30 * * * *",
      "timezone": "America/New_York",
      "from": "2026-11-01T04:45:00Z",
      "expect": ["2026-11-01T05:00:00Z", "2026-11-01T05:30:00Z", "2026-11-01T07:00:00Z"]
    },
    {
      "name": "London spring-forward gap",
      "schedule": "30 1 * * *",
      "timezone": "Europe/London",
      "from": "2026-03-28T12:00:00Z",
      "expect": ["2026-03-29T01:00:00Z", "2026-03-30T00:30:00Z"]
    },
    {
      "name": "London fall-back",
      "schedule": "30 1 * * *",
      "timezone": "Europe/London",
      "from": "2026-10-24T12:00:00Z",
      "expect": ["2026-10-25T00:30:00Z", "2026-10-26T01:30:00Z"]
    },
    {
      "name": "Lord Howe 30-minute spring-forward gap",
      "schedule": "15 2 * * *",
      "timezone": "Australia/Lord_Howe",
      "from": "2026-10-03T00:00:00Z",
      "expect": ["2026-10-03T15:30:00Z", "2026-10-04T15:15:00Z"]
    },
    {
      "name": "Lord Howe 30-minute fall-back",
      "schedule": "45 1 * * *",
      "timezone": "Australia/Lord_Howe",
      "from": "2026-04-04T12:00:00Z",
      "expect": ["2026-04-04T14:45:00Z", "2026-04-05T15:15:00Z"]
    }
  ],
  "invalid": [
    { "schedule": "* * * *", "code": "invalid_schedule", "start": 0, "end": 7 },
    { "schedule": "0 0 * * * *", "code": "invalid_schedule", "start": 0, "end": 11 },
    { "schedule": "61 * * * *", "code": "invalid_schedule", "start": 0, "end": 2 },
    { "schedule": "0 25 * * *", "code": "invalid_schedule", "start": 2, "end": 4 },
    { "schedule": "0 0 ? * *", "code": "invalid_schedule", "start": 4, "end": 5 },
    { "schedule": "0 0 L * *", "code": "invalid_schedule", "start": 4, "end": 5 },
    { "schedule": "0 0 15W * *", "code": "invalid_schedule", "start": 6, "end": 7 },
    { "schedule": "0 0 * * 5#3", "code": "invalid_schedule", "start": 9, "end": 10 },
    { "schedule": "@reboot", "code": "invalid_schedule", "start": 0, "end": 7 },
    { "schedule": "*/61 * * * *", "code": "invalid_schedule", "start": 0, "end": 4 },
    { "schedule": "0 0 * FOO *", "code": "invalid_schedule", "start": 6, "end": 9 },
    { "schedule": "0 0,70 * * *", "code": "invalid_schedule", "start": 4, "end": 6 },
    { "schedule": "5-1 * * * *", "code": "invalid_schedule", "start": 0, "end": 3 }
  ]
}
